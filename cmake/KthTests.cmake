# CI runs a few complete Catch2 shards rather than starting one process for
# every test case. Local builds retain ordinary Catch discovery by default.
set(KTH_CI_TEST_SHARDS 0 CACHE STRING "CI node/domain shard count (0 uses Catch discovery)")
if(NOT KTH_CI_TEST_SHARDS MATCHES "^[0-9]+$" OR KTH_CI_TEST_SHARDS GREATER 16)
    message(FATAL_ERROR "KTH_CI_TEST_SHARDS must be between 0 and 16")
endif()

function(kth_register_tests target)
    cmake_parse_arguments(ARG "" "TEST_SPEC;TIMEOUT" "" ${ARGN})
    if(KTH_CI_TEST_SHARDS GREATER 0)
        set(count 1)
        if(target STREQUAL "kth_node_test" OR target STREQUAL "kth_domain_test")
            set(count ${KTH_CI_TEST_SHARDS})
        endif()
        if(NOT ARG_TIMEOUT)
            set(ARG_TIMEOUT 1500)
        elseif(target STREQUAL "kth_node_test")
            set(ARG_TIMEOUT 1800)
        endif()
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            set(directory "${CMAKE_BINARY_DIR}/ci-tests/${target}/${index}")
            file(MAKE_DIRECTORY "${directory}/tmp")
            set(name "${target}.shard-${index}-of-${count}")
            add_test(NAME ${name} COMMAND ${target} ${ARG_TEST_SPEC}
                --reporter compact --durations yes --min-duration 1
                --order lex --shard-count ${count} --shard-index ${index})
            set_tests_properties(${name} PROPERTIES
                TIMEOUT ${ARG_TIMEOUT} WORKING_DIRECTORY "${directory}"
                ENVIRONMENT "TMPDIR=${directory}/tmp;TMP=${directory}/tmp;TEMP=${directory}/tmp")
        endforeach()
    else()
        find_package(Catch2 QUIET)
        if(Catch2_FOUND)
            include(Catch)
            if(ARG_TIMEOUT)
                catch_discover_tests(${target} TEST_SPEC ${ARG_TEST_SPEC} PROPERTIES TIMEOUT ${ARG_TIMEOUT})
            else()
                catch_discover_tests(${target} TEST_SPEC ${ARG_TEST_SPEC})
            endif()
        else()
            add_test(NAME ${target} COMMAND ${target} ${ARG_TEST_SPEC})
            if(ARG_TIMEOUT)
                set_tests_properties(${target} PROPERTIES TIMEOUT ${ARG_TIMEOUT})
            endif()
        endif()
    endif()
endfunction()
